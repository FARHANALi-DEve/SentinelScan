# Live scanning is OFF unless you add exact, authorized public website hostnames.
# Example: ALLOWED_TARGET_HOSTS=yourwebsite.com,www.yourwebsite.com
ALLOWED_TARGET_HOSTS=

# Default relative location when run via start-all.bat from the project root.
DATABASE_PATH=backend/sentinelscan.db

# Local browser addresses allowed to call the private Python API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# No fixed owner credentials here: create your account in the browser on first run.
# Do not expose port 8000 publicly. Never scan without explicit permission.
